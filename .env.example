# Copy to .env and adjust as needed. All values are optional — the app runs
# with sensible defaults if this file is absent.
#   cp .env.example .env

# --- Django ---
# Generate a new one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=django-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# --- Vehicle characteristics (from the assessment brief) ---
VEHICLE_MAX_RANGE_MILES=500
VEHICLE_MPG=10
# How far (miles) a station may sit off the route and still count as "on the way".
ROUTE_CORRIDOR_MILES=5

# --- External free services (no API key required) ---
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
HTTP_USER_AGENT=spotter-fuel-route-assessment/1.0
HTTP_TIMEOUT_SECONDS=20
